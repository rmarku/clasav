<!DOCTYPE html>
<html>
<head lang="en">
    <meta charset="UTF-8">
    <title>Errores</title>
    <link rel="stylesheet" href="/js/dependencies/bootstrap/dist/css/bootstrap.css">
</head>
<body>
<h1>Errores</h1>

<div class="control-group">
    <table>
        <% _.each(logs, function(log) { %>
        <tr>
            <td><%= log.createdAt %></td>
            <td><%= log.context %></td>
            <td><%= log.details %></td>
        </tr>
        <% }) %>
    </table>
</div>
</body>
</html>