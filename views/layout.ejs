					<button type="submit" class="btn btn-default">
							Crear Cuenta
						</button>
				</div>
				<div class="text-right col-md-9">
					<form class="form-inline" role="form">
						<div class="form-group">
							<label class="sr-only" for="email">Email address</label>
							<input type="email" class="form-control" name="email" ng-model="usuario.email" placeholder="Introduce tu E-mail" required>
						</div>
						<div class="form-group">
							<label class="sr-only" for="exampleInputPassword2">Password</label>
							<input type="password" class="form-control" id="contrasena" placeholder="Password">
						</div>
						<button type="submit" class="btn btn-default">
							Ingresar
						</button>
					</form>
				</div>
			</div>

  	<!--h1>Titulo del Juego</h1-->
			<img src="images/init.png"/>
        <!--BOTONERA-->
        <div class="btn-group botonera">
	        <a href="index.html" type="button" class="btn btn-default">Home</a>
				<a href="login.html" class="btn btn-default">Login</a>
	        <a href="gmisiones.html" class="btn btn-default">Guia de Misiones</a>
	        <a href="" class="btn btn-default">COLISEO</a>
		        <div class="btn-group">
			        <a class="btn btn-default dropdown-toggle" data-toggle="dropdown">Estadisticas<span class="caret"></span></a>
					  <ul class="dropdown-menu" role="menu">
						<li>
							<a href="#">Mi Personaje</a>
						</li>
						<li>
							<a href="#">Ranking</a>
						</li>
					  </ul>
				</div>
	        <a href="game.html" type="button" class="btn btn-default">Juego</a>
        </div>
        <!--FIN DE BOTONERA-->
        </div>
</header>
    <%- body %>



