<!DOCTYPE html>
<html ng-app="juegoapl">
	<head>
		<title>Juegos y Aventuras</title>
		<!--link href='images/dragonr.ico' rel='shortcut icon' type='image/x-icon'-->
		<link href='images/icodragon.ico' rel='shortcut icon' type='image/x-icon'>
		<!-- Viewport mobile tag for sensible mobile support -->
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
		<link href='http://fonts.googleapis.com/css?family=Short+Stack' rel='stylesheet' type='text/css'>

<link rel="stylesheet" href="/js/dependencies/bootstrap/dist/css/bootstrap-theme.css">
<link rel="stylesheet" href="/js/dependencies/bootstrap/dist/css/bootstrap.css">
<link rel="stylesheet" href="/styles/comun.css">
<link rel="stylesheet" href="/styles/importer.css">

		
	</head>

	<body class="body-gradient">
		<header class="text-center">
			<div class="navbar navbar-inverse row">
				<div class="text-left col-md-3">
					<a href="#/crear-cuenta" class="btn btn2 btn-default">Crear Cuenta</a>
				</div>
				<div class="text-right col-md-9">
					<form class="form-inline" role="form">
						<div class="form-group">
							<label class="sr-only" for="email">Email address</label>
							<input type="email" class="form-control2" name="email" size="40" ng-model="alumno.e_mail" placeholder="Introduce tu E-mail" required>
						</div>
						<div class="form-group">
							<label class="sr-only" for="contrasena">Password</label>
							<input type="password" class="form-control2" name="contrasena" id="contrasena" ng-model="alumno.contrasena" placeholder="Contrase&ntilde;a">
						</div>
						<a href="#/crear-cuenta" class="btn btn2 btn-default">Ingresar</a>
					</form>
				</div>
			</div>

			<!--h1>Titulo del Juego</h1-->
			<img src="images/init.png"/>
			<br />
			<!--BOTONERA-->
			<div class="btn-group botonera">
				<a href="#/" type="button" class="btn btn-default">Home</a>
				<a href="#/misiones" class="btn btn-default">Guia de Misiones</a>
				<a href="" class="btn btn-default">COLISEO</a>
				<div class="btn-group">
					<a class="btn btn-default dropdown-toggle" data-toggle="dropdown">Estadisticas<span class="caret"></span></a>
					<ul class="dropdown-menu" role="menu">
						<li>
							<a href="#">Mi Personaje</a>
						</li>
						<li>
							<a href="#">Ranking</a>
						</li>
					</ul>
				</div>
				<a href="#/game" type="button" class="btn btn-default">Juego</a>
			</div>
			<!--FIN DE BOTONERA-->
			</div>
		</header>
		<div ng-view></div>
		<!--%- body %-->
		<!--TEMPLATES-->
<script type="text/javascript" src="/jst.js"></script>
<!--TEMPLATES END-->

		<footer>
			<!--h1>Titulo del Juego</h1-->
			<img src="images/logoUCC.png" /> Universidad Catolica de Cordoba
		</footer>


<script src="/js/dependencies/sails.io.js/dist/sails.io.js"></script>
<script src="/js/dependencies/angular/angular.js"></script>
<script src="/js/dependencies/jquery/dist/jquery.js"></script>
<script src="/js/dependencies/angular-resource/angular-resource.js"></script>
<script src="/js/dependencies/angular-route/angular-route.js"></script>
<script src="/js/dependencies/angular-sails-bind/dist/angular-sails-bind.js"></script>
<script src="/js/dependencies/bootstrap/dist/js/bootstrap.js"></script>
<!--script src="/js/dependencies/melonJS/melonJS.js"></script-->
        <script src="/lib/melonJS.js"></script>
        <script src="/lib/plugins/debug/debugPanel.js"></script>
        <script src="/lib/plugins/debug/particleDebugPanel.js"></script>

<script src="/js/main.js"></script>
<script src="/js/app.js"></script>
<script src="/js/comun.js"></script>
<script src="/js/controlador.js"></script>
<script src="/js/entities/player.js"></script>
<script src="/js/personajes.js"></script>
<script src="/js/play.js"></script>
<script src="/js/servicios.js"></script>

		<script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/lodash.js/0.10.0/lodash.min.js"></script>
	</body>
</html>
