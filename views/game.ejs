<!DOCTYPE html>
<html ng-app="juegoapl">
	<head>
		<title>Clases y Aventuras</title>
		<link href='images/favicon.ico' rel='shortcut icon' type='image/x-icon'>
		<!-- Viewport mobile tag for sensible mobile support -->
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black">
		<link href='http://fonts.googleapis.com/css?family=Short+Stack' rel='stylesheet' type='text/css'>

		<link rel="stylesheet" href="/js/dependencies/bootstrap/dist/css/bootstrap.css">
		<link rel="stylesheet" href="/js/dependencies/BrandButtons/dist/brand-buttons.min.css">
		<link rel="stylesheet" href="/js/dependencies/BrandButtons/dist/brand-buttons-inversed.min.css">
		<link rel="stylesheet" href="/js/dependencies/font-awesome/css/font-awesome.min.css">
		<link rel="stylesheet" href="/js/dependencies/angular-toastr/dist/angular-toastr.css">
		<link rel="stylesheet" href="/styles/comun.css">
		<link rel="stylesheet" href="/styles/importer.css">

	</head>
	<body style="background: #000000" onload="window.scrollTo(0, 1);game.start();">
		<div id="jsapp">
			<!--HUD SUPERIOR-->
			<div id="hudSuperior" class="capaSup">
				<!--img src="images/iconos/circuloNivel.png" style="float: left; width: 68px; height: 68px;"-->
				<div class="nivelPJ">
					<b><span id="PJnivel">1</span></font>
					<br>
					Nivel</b>
				</div>

				<div class="progress" style="margin: 5px 0 0 75px;width: 200px">
					<div id="PJenergia" class="progress-bar progress-bar-striped progress-bar-warning" role="progressbar" aria-valuenow="60"
					aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div>

					<div style="position: absolute; float: left">
						<b>Energia</b>
					</div>
				</div>
				<div class="progress" style="margin: 5px 0  0 75px;width: 200px">
					<div id="PJexperiencia" class="progress-bar progress-bar-striped" role="progressbar" aria-valuenow="20" aria-valuemin="0"
					aria-valuemax="100" style="width: 0%;"></div>

					<div style="position: absolute; float:left;">
						<b>Experiencia</b>
					</div>
				</div>
                <div class="gold">
                    <img src="/images/iconos/coin.png" ><b><span id="PJoro">0</span></b>
                </div>

			</div>

			<!--HUD INFERIOR-->
			<div id="botonera" class="capaSup" style="height: 49px; width: 261px; position: absolute; bottom: 0px">
				<img id="btnInve" src="images/iconos/btn_inventario.png" onclick="hud.inventario.toggle()"/>
				<img id="btnMisi" src="images/iconos/btn_mision.png" onclick="hud.misiones.toggle()" style="margin-left: -4px;"/>
				<img id="btnLogr" src="images/iconos/btn_logros.png" onclick="hud.logros.toggle()" style="margin-left: -4px;"/>
				<img id="btnTale" src="images/iconos/btn_talentos.png" onclick="hud.talentos.toggle()" style="margin-left: -4px;"/>
				<img id="btnPers" src="images/iconos/btn_personaje.png" onclick="hud.personaje.toggle()" style="margin-left: -4px;"/>
			</div>
			<img class="capaSup" id="audio" src="images/iconos/audio_OFF.png" style="position: absolute; bottom: 4px; right: 4px"  onclick="hud.toggleAudio()"/>
			<a href="/"> <img class="capaSup" id="home" src="images/iconos/btn_home.png" style="position: absolute; bottom: 32px; right: 4px"/> </a>
			<!--img class="capaSup" id="sfx" src="images/iconos/sfx_on.png" tyle="position: absolute; bottom: 4px; right: 34px"/-->

			<!--INVENTARIO-->
			<div id="inv" class="div-panel"style="background: url('images/iconos/inventario2.png')">
				<p class="capaSup titulo-botonera">
					Inventario
				</p>

				<div id="items" style="padding: 41px 7px 0px 9px">
					<div 					style="display: inline; width: 49px; height: 49px; margin: 0px -1px 0px -3px; border: 0px 0px 0px 0px">
						<img ng-src="{{x.sprite}}" title="{{x.nombreItem}}">
						<span ng-class="{hidden: x.acumulable==false}"
						style="position: absolute; margin: 25px 0px 0px -13px">{{x.cant}}</span>
					</div>
				</div>
			</div>

			<!--INVENTARIO-->
			<div id="inv" class="div-panel"style="background: url('images/iconos/inventario2.png')">
				<p class="capaSup titulo-botonera">
					Inventario
				</p>

				<div id="items" style="padding: 41px 7px 0px 9px">
					<div class="itemInv" >
						<img src="" title="">
						<span></span>
					</div>
				</div>
			</div>

			<!--MISIONES-->
			<div id="mis" class="div-panel" style="background: url('images/iconos/misiones2.png')">
				<p class="capaSup titulo-botonera">
					Misiones
				</p>

				<div id="misiones" style="margin: 43px 7px 0px 9px; overflow-y: auto; width: 293px; height: 243px">
					<table>
						<tbody>
							<tr ng-repeat="x in misiones">
								<td><img src="images/quest/inventario.png"/></td>
								<td> {{x.tituloMision}}</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!--LOGROS-->
			<div id="log" class="div-panel" style="background: url('images/iconos/logros2.png')">
				<p class="capaSup titulo-botonera">
					Logros
				</p>

				<div id="items" style="margin: 43px 7px 0px 9px; overflow-y: auto; width: 293px; height: 243px">
					<table>
						<tbody>
							<tr ng-repeat="x in logros">
								<td><img ng-src="{{x.sprite}}"></td>
								<td>{{ x.tituloLogro }}</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!--TALENTOS-->
			<div id="tal" class="div-panel" style="background: url('images/iconos/talentos2.png')">
				<p class="capaSup titulo-botonera">
					Talentos
				</p>
			</div>

			<!--PERSONAJE-->
			<div id="per" class="div-panel" style="background: url('images/iconos/personaje2.png')">
				<p class="capaSup titulo-botonera">
					Personaje
				</p>

				<div align="left" style="width: 49px; position: absolute; margin-top: 42px; margin-left: 12px">
					<div id="PJsombrero" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJtorso" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJpantalon" class="itemP">
						<img src="../data/sprites/items/empty.png">
					</div>
					<div id="PJzapatos" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJbrazo" class="itemP">
                        <img src="data/sprites/items/empty.png">
                    </div>

				</div>

				<!--CANVAS PERSONAJE-->
				<canvas id="PJimage" width="32" height="48" style="position: absolute"></canvas>
				<div id="imagenes" style="position: absolute"></div>
				<!--FIN CANVAS PERSONAJE-->

				<div align="right" style="position: absolute; width: 49px; right: 8px; margin-top: 42px">
					<div id="PJdecoracion1" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJdecoracion2" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJcapa" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJanillo" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
					<div id="PJespalda" class="itemP">
						<img src="data/sprites/items/empty.png">
					</div>
				</div>
			</div>

			<!--ventana de amigos-->
			<div id="ventAmigos" class="titulo-botonera capaSup" style="background-color: #FBF8EF; border: 2px solid #FF8000; margin: 176px 0 0 0; width: 176px; height: 250px; right: 0px;    overflow: auto;">
				<div style="background-color: #FF8000; text-align: center">
					<strong> Lista de Amigos </strong>
				</div>
				Conectados
				<div style="overflow-y: auto;"></div>
				Desconectados
				<div style="overflow-y: auto;"></div>
			</div>

			<!--MAPA-->
			<div style="width: 176px; height: 176px; display:block; position: absolute;right: 0px;top:0px">
				<img src="images/iconos/MarcoMap.png" style="position: absolute;float: left">

				<div id=divMinimapa class="div-mapa">
                    <img id="minimap_img" src="images/map.png" style="position:absolute; float: left;"/>
					<canvas id="canvasMinimap" style="position:absolute; float: left;" width="156" height="156"></canvas>
				</div>

			</div>

			<!--CHAT-->
			<div id="ChatGame" ng-controller="ChatController" class="capaSup" style="bottom: 0px; left:245px; right: 32px; text-align: center; overflow: hidden">
				<div id="glyChat" class="glyphicon glyphicon-comment" style="background-color: white; width: 24px; height: 16px;border-radius: 6px"></div>
				<div class="divChat" id="divChat" style="width: 100%;">
					<span ng-repeat="msj in chats | orderBy: 'createdAt'"> <b ng-class=""> {{msj.nick}} : </b> {{msj.mensaje}}
						<br>
					</span>
				</div>
				<button type="submit" class="btn btn-default" id="btn_enviar" ng-click="envMsj()" style="float: right;">
					Enviar
				</button>
				<div style="overflow: hidden; padding: 0 1px 0 0">
					<input chat="envMsj()" class="form-control" type="text" ng-model="mensaje"  id="msjChat" style="width: 100%">
				</div>
			</div>

			<!--GAME-->
			<div id="game-parent" style="text-align: center">
				<div id="game"></div>
			</div>

			<!--Ventana de Misiones-->
			<div id="mision" style="display:none; position: absolute; top:0px; width: 100%">
				<div class="capaSup questModal">
					<p id="mision_titulo" class="capaSup titulo-botonera" style="margin-left: 80px">
                        <!-- Titulo Mision -->
					</p>
					<span id="mision_npc" style="position: absolute; margin: 123px 0px 0px 36px">
                        <!-- Nombre NPC -->
                    </span>

					<div id="mision_txt" style="">

					</div>
					<!--img id="cerrar" style="position: absolute; right: 0px" src="images/quest/cerrar.png"/-->
                    <div style="position: absolute; right: 34px; text-align: right;bottom: 19px;">
                        <span id="mision_aceptar"   onclick="game.mision.aceptar()"     class="btn-quest" type="button" > Aceptar </span>
                        <span id="mision_siguiente" onclick="game.mision.siguiente(1)"  class="btn-quest" type="button" > Siguiente </span>
                        <span id="mision_cancelar"  onclick="game.mision.cancelar()"    class="btn-quest" type="button" > Cancelar </span>
                        <span id="mision_salir"     onclick="game.mision.cancelar()"    class="btn-quest" type="button" > Salir </span>
                    </div>

				</div>
			</div>
		</div>
		<script src="/js/dependencies/sails.io.js/dist/sails.io.js"></script>
		<script src="/js/dependencies/angular/angular.js"></script>
		<script src="/js/dependencies/jquery/dist/jquery.js"></script>
		<script src="/js/dependencies/bootstrap/dist/js/bootstrap.js"></script>
		<script src="/js/dependencies/angular-resource/angular-resource.js"></script>
		<script src="/js/dependencies/lodash/dist/lodash.js"></script>
		<script src="/js/dependencies/angular-route/angular-route.js"></script>
		<script src="/js/dependencies/angular-sails-bind/dist/angular-sails-bind.js"></script>
		<script src="/js/dependencies/angular-toastr/dist/angular-toastr.js"></script>
		<script src="/lib/melonJS-2.0.2.js"></script>
		<script src="/lib/plugins/debug/debugPanel.js"></script>
		<script src="/lib/plugins/debug/particleDebugPanel.js"></script>
		<script src="/lib/plugins/astar.js"></script>
		<script src="/js/juego/main.js"></script>
		<script src="/js/juego/entities/player.js"></script>
		<script src="/js/juego/entities/mainPlayer.js"></script>
		<script src="/js/juego/entities/otherPlayer.js"></script>
		<script src="/js/juego/entities/NPCPlayer.js"></script>
		<script src="/js/juego/entities/clavLevelEntity.js"></script>
		<script src="/js/juego/hud.js"></script>
		<script src="/js/juego/minimap.js"></script>
		<script src="/js/juego/play.js"></script>
		<script src="/js/juego/chat.js"></script>
		<script src="/js/juego/server.js"></script>
		<script src="/js/juego/misiones.js"></script>
		<script src="/js/juego/logros.js"></script>
		<script src="/js/juego/pregunta4.js"></script>
		<script src="/js/helpers.js"></script>
	</body>
</html>
