<!DOCTYPE html>
<html ng-app="juegoapl">
<head>
    <title>Clases y Aventuras</title>
    <link href='images/favicon.ico' rel='shortcut icon' type='image/x-icon'>
    <!-- Viewport mobile tag for sensible mobile support -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <link href='http://fonts.googleapis.com/css?family=Short+Stack' rel='stylesheet' type='text/css'>

    <link rel="stylesheet" href="/js/dependencies/bootstrap/dist/css/bootstrap.css">
    <link rel="stylesheet" href="/js/dependencies/BrandButtons/dist/brand-buttons.min.css">
    <link rel="stylesheet" href="/js/dependencies/BrandButtons/dist/brand-buttons-inversed.min.css">
    <link rel="stylesheet" href="/js/dependencies/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/js/dependencies/angular-toastr/dist/angular-toastr.css">
    <link rel="stylesheet" href="/styles/comun.css">
    <link rel="stylesheet" href="/styles/importer.css">

</head>
<body ng-controller="bodyController" style="background: #000000" onload="window.scrollTo(0, 1);">
<div id="jsapp" ng-controller="gamePageController">
    <!--HUD SUPERIOR-->
    <div id="hudSuperior" class="capaSup">
        <img src="data/sprites/characters/masculino/face/pepe.png" style="float: left;">

        <div class="progress" style="margin-left: 100px; margin-top: 10px ;width: 200px">
            <div class="progress-bar progress-bar-striped progress-bar-warning" role="progressbar"
                 aria-valuenow="60"
                 aria-valuemin="0" aria-valuemax="100" style="width: 60%;"></div>

            <div style="position: absolute; float: left">
                <b>Energia</b>
            </div>
        </div>
        <div class="progress" style="margin-left: 100px; margin-top: -10px ;width: 200px">
            <div class="progress-bar progress-bar-striped" role="progressbar" aria-valuenow="20" aria-valuemin="0"
                 aria-valuemax="100" style="width: 60%;"></div>

            <div style="position: absolute; float:left;">
                <b>Experiencia</b>
            </div>
        </div>
    </div>

    <!--HUD INFERIOR-->

    <div id="botonera" class="capaSup" style="height: 49px; width: 261px; position: absolute; bottom: 0px">
        <img id="btnInve" src="images/iconos/btn_inventario.png"/>
        <img id="btnMisi" src="images/iconos/btn_mision.png" style="margin-left: -4px;"/>
        <img id="btnLogr" src="images/iconos/btn_logros.png" style="margin-left: -4px;"/>
        <img id="btnTale" src="images/iconos/btn_talentos.png" style="margin-left: -4px;"/>
        <img id="btnPers" src="images/iconos/btn_personaje.png" style="margin-left: -4px;"/>
    </div>

    <img class="capaSup" id="audio" src="images/iconos/audio_OFF.png"
         style="position: absolute; bottom: 4px; right: 4px"/>
    <a href="/">
        <img class="capaSup" id="home" src="images/iconos/btn_home.png"
             style="position: absolute; bottom: 32px; right: 4px"/>
    </a>
    <!--img class="capaSup" id="sfx" src="images/iconos/sfx_on.png" tyle="position: absolute; bottom: 4px; right: 34px"/-->

    <!--INVENTARIO-->
    <div id="inv" class="div-panel" ng-controller="inventarioContr"
         style="background: url('images/iconos/inventario2.png')">
        <p class="capaSup titulo-botonera">
            Inventario
        </p>

        <div id="items" style="padding: 41px 7px 0px 9px">
            <div ng-repeat="x in inventario"
                 style="display: inline; width: 49px; height: 49px; margin: 0px -1px 0px -3px; border: 0px 0px 0px 0px">
                <img ng-src="{{x.sprite}}" title="{{x.nombreItem}}">
						<span ng-class="{hidden: x.acumulable==false}"
                              style="position: absolute; margin: 25px 0px 0px -13px">{{x.cant}}</span>
            </div>
        </div>
    </div>

    <!--INVENTARIO-->
    <div id="inv" class="div-panel" ng-controller="inventarioContr"
         style="background: url('images/iconos/inventario2.png')">
        <p class="capaSup titulo-botonera">
            Inventario
        </p>

        <div id="items" style="padding: 41px 7px 0px 9px">
            <div ng-repeat="x in inventario"
                 style="display: inline; width: 49px; height: 49px; margin: 0px -1px 0px -3px; border: 0px 0px 0px 0px">
                <img ng-src="{{x.sprite}}" title="{{x.nombreItem}}">
                <span ng-class="{hidden: x.acumulable==false}"
                      style="position: absolute; margin: 25px 0px 0px -13px">{{x.cant}}</span>
            </div>
        </div>
    </div>

    <!--MISIONES-->
    <div id="mis" ng-controller="misionesGuia" class="div-panel"
         style="background: url('images/iconos/misiones2.png')">
        <p class="capaSup titulo-botonera">
            Misiones
        </p>

        <div id="misiones" style="margin: 43px 7px 0px 9px; overflow-y: auto; width: 293px; height: 243px">
            <table>
                <tbody>
                <tr ng-repeat="x in misiones">
                    <td><img src="images/quest/inventario.png"/></td>
                    <td> {{x.tituloMision}}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>


    <!--LOGROS-->
    <div id="log" class="div-panel" ng-controller="listaLogros"
         style="background: url('images/iconos/logros2.png')">
        <p class="capaSup titulo-botonera">
            Logros
        </p>

        <div id="items" style="margin: 43px 7px 0px 9px; overflow-y: auto; width: 293px; height: 243px">
            <table>
                <tbody>
                <tr ng-repeat="x in logros">
                    <td><img ng-src="{{x.sprite}}"></td>
                    <td>{{ x.tituloLogro }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!--TALENTOS-->
    <div id="tal" class="div-panel" style="background: url('images/iconos/talentos2.png')">
        <p class="capaSup titulo-botonera">
            Talentos
        </p>
    </div>

    <!--PERSONAJE-->
    <div id="per" class="div-panel" style="background: url('images/iconos/personaje2.png')">
        <p class="capaSup titulo-botonera">
            Personaje
        </p>

        <div align="left" style="width: 49px; position: absolute; margin-top: 42px; margin-left: 12px">
            <div id="itemCabeza" class="itemP">
                <img src="../data/sprites/items/cabeza/1.png">
            </div>
            <div id="itemPechera" class="itemP">
                <img src="../data/sprites/items/pechera/1.png">
            </div>
            <div id="itemPantalon" class="itemP">
                <img src="../data/sprites/items/pantalon/1.png">
            </div>
            <div id="itemPie" class="itemP">
                <img src="../data/sprites/items/pies/1.png">
            </div>
            <div id="itemMano" class="itemP"></div>

        </div>

        <!--CANVAS PERSONAJE-->
        <!--canvas id="pj" width="32" height="48" style="position: absolute"></canvas>
        <div id="imagenes" style="position: absolute"></div-->
        <!--FIN CANVAS PERSONAJE-->

        <div align="right" style="position: absolute; width: 49px; right: 8px; margin-top: 42px">
            <div id="itemEspec1" class="itemP">
                <img src="../data/sprites/items/acc/1.png">
            </div>
            <div id="itemEspec2" class="itemP">
                <img src="../data/sprites/items/acc/2.png">
            </div>
            <div id="itemCapa" class="itemP">
                <img src="../data/sprites/items/capa/1.png">
            </div>
            <div id="itemAnillo" class="itemP">
                <img src="../data/sprites/items/anillo/3.png">
            </div>
            <div id="itemArma" class="itemP">
                <img src="../data/sprites/items/arma/1.png">
            </div>
        </div>
    </div>
    <!--MAPA-->
    <div style="width: 176px; height: 176px; display:block; position: absolute;right: 0px;top:0px">
        <img src="images/iconos/MarcoMap.png" style="position: absolute;float: left">

        <div id=divMinimapa class="div-mapa"
             style="width: 156px; height: 156px; position: absolute; float: left; margin-left: 9px; margin-top: 11px">
            <canvas id="canvasMinimap" width="156" height="156"></canvas>
        </div>

    </div>

    <!--CHAT-->
    <div ng-controller="ChatController" style="width: 800px; bottom: 0px; left:245px;" class="capaSup">
        <div class="divChat" id="divChat">
					<span ng-repeat="msj in chats | orderBy: 'createdAt'"> <b ng-class=""> {{msj.nick}} : </b> {{msj.mensaje}}
						<br>
					</span>
        </div>

        <input chat="envMsj()" class="form-control" type="text" ng-model="mensaje" id="msjChat"
               style="display: inline; width: 730px">
        <button type="submit" class="btn btn-default" id="btn_enviar" ng-click="envMsj()">
            Enviar
        </button>
    </div>

    <!--ventana de amigos-->
    <div class="titulo-botonera"
         style=" display:none; background-color: #FBF8EF; border: 2px solid #FF8000; margin: 30px 0px; height: 277px;">
        <div style="background-color: #FF8000">
            <strong> Lista de Amigos </strong>
        </div>
        Conectados
        <div style="overflow-y: auto;"></div>
        Desconectados
        <div style="overflow-y: auto;"></div>
    </div>
    <div id="game-parent" style="text-align: center">
        <div id="game"></div>
    </div>

    <!--Ventana de Misiones-->
    <div style="position: absolute; top:0px; width: 100%">
        <div class="capaSup questModal" ng-controller="misionesGuia" id="quest">
            <p class="capaSup titulo-botonera" style="margin-left: 80px"
               ng-repeat="x in misiones | filter: { mapa: 'Principal' , id: 1}">
                {{ x.tituloMision }}
            </p>
        <span ng-repeat="x in misiones | filter: { mapa: 'Principal' , id: 1}"
              style="position: absolute; margin: 123px 0px 0px 36px"> {{ x.inicipioNPC }} </span>

            <div ng-repeat="x in misiones | filter: { mapa: 'Principal' , id: 1}"
                 style="position: absolute;width: 342px; height: 200px; margin: 47px 0px 0px 123px; overflow-y: auto">
                {{ x.textoInicial }}
            </div>
            <img id="cerrar" style="position: absolute; right: 0px" src="images/quest/cerrar.png"/>
            <span class="btn-quest" type="button" style="position: absolute; bottom: 19px; right: 34px"> Aceptar </span>

        </div>
    </div>
</div>
<script src="/js/dependencies/sails.io.js/dist/sails.io.js"></script>
<script src="/js/dependencies/angular/angular.js"></script>
<script src="/js/dependencies/jquery/dist/jquery.js"></script>
<script src="/js/dependencies/bootstrap/dist/js/bootstrap.js"></script>
<script src="/js/dependencies/angular-resource/angular-resource.js"></script>
<script src="/js/dependencies/lodash/dist/lodash.js"></script>
<script src="/js/dependencies/angular-route/angular-route.js"></script>
<script src="/js/dependencies/angular-sails-bind/dist/angular-sails-bind.js"></script>
<script src="/js/dependencies/angular-toastr/dist/angular-toastr.js"></script>
<script src="/lib/melonJS-2.0.2.js"></script>
<script src="/lib/plugins/debug/debugPanel.js"></script>
<script src="/lib/plugins/debug/particleDebugPanel.js"></script>
<script src="/lib/plugins/astar.js"></script>
<script src="/js/juego/main.js"></script>
<script src="/js/juego/entities/player.js"></script>
<script src="/js/juego/entities/mainPlayer.js"></script>
<script src="/js/juego/entities/otherPlayer.js"></script>
<script src="/js/juego/entities/NPCPlayer.js"></script>
<script src="/js/juego/entities/clavLevelEntity.js"></script>
<script src="/js/juego/hud.js"></script>
<script src="/js/juego/minimap.js"></script>
<script src="/js/juego/play.js"></script>
<script src="/js/juego/chat.js"></script>
<script src="/js/juego/server.js"></script>
<script src="/js/juego/misiones.js"></script>
<script src="/js/juego/logros.js"></script>
<script src="/js/juego/pregunta4.js"></script>
<script src="/js/controladores/navVar.js"></script>
<script src="/js/controladores/controlador.js"></script>
<script src="/js/helpers.js"></script>
<script src="/js/controladores/personajes.js"></script>
<script src="/js/controladores/editUsuario.js"></script>
</body>
</html>
